  "components": {
    "schemas": {
      "AlertItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "file_title": {
            "type": "string",
            "title": "File Title"
          },
          "level": {
            "$ref": "#/components/schemas/AlertLevel"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_id",
          "file_title",
          "level",
          "message",
          "created_at"
        ],
        "title": "AlertItem"
      },
      "AlertLevel": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "critical"
        ],
        "title": "AlertLevel"
      },
      "Body_create_file_view_files_post": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "title",
          "file"
        ],
        "title": "Body_create_file_view_files_post"
      },
      "FileItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "original_name": {
            "type": "string",
            "title": "Original Name"
          },
          "mime_type": {
            "type": "string",
            "title": "Mime Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "processing_status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "scan_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScanStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "scan_details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scan Details"
          },
          "metadata_json": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata Json"
          },
          "requires_attention": {
            "type": "boolean",
            "title": "Requires Attention"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "original_name",
          "mime_type",
          "size",
          "processing_status",
          "scan_status",
          "scan_details",
          "metadata_json",
          "requires_attention",
          "created_at",
          "updated_at"
        ],
        "title": "FileItem"
      },
      "FileUpdate": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "FileUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProcessingStatus": {
        "type": "string",
        "enum": [
          "uploaded",
          "processing",
          "processed",
          "failed"
        ],
        "title": "ProcessingStatus"
      },
      "ScanStatus": {
        "type": "string",
        "enum": [
          "clean",
          "suspicious",
          "failed"
        ],
        "title": "ScanStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
